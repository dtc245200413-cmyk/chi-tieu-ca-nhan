# Sao chép tệp này thành .env trước khi chạy Docker Compose.
# Điền các giá trị bí mật bằng chuỗi ngẫu nhiên riêng và đủ dài; không gửi .env lên chat hoặc commit tệp này.
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=
APP_SECRET_KEY=
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=
